CONFIG_APP_ENABLE=y
CONFIG_APP_PRIORITY=1
# Words, not bytes. The app task runs the policy forward pass: two 128-float
# hidden-activation buffers plus the 40-float observation live on its stack
# (~1.4 KB), on top of FreeRTOS/printf overhead. 350 (the template default)
# overflows; 1000 words = 4 KB leaves ~2.5x headroom.
CONFIG_APP_STACKSIZE=1000
CONFIG_CONTROLLER_OOT=y
# Kalman prediction at 500 Hz (upstream 100): the externalized position and
# velocity the policy observes are then at most 2 ms behind the IMU instead
# of 10 ms. Everything else in the estimator already runs at 1 kHz. Costs
# ~5x the prediction step's CPU; check stabilizer rate warnings on the
# console after flashing. See CONFIG_ESTIMATOR_KALMAN_PREDICT_RATE.
CONFIG_ESTIMATOR_KALMAN_PREDICT_RATE=500
# The external pose is corrected against the state the estimator held when
# the pose was captured (EXT_POSE_AGED, kalman.poseComp / poseD0Ms): without
# it the position the policy observes lags by speed x mocap latency.
CONFIG_ESTIMATOR_KALMAN_POSE_DELAY_COMP=y
